// 核心表设计依据：《docs/技术决策方案-架构与选型.md》§7
// 金额字段统一 BigInt（最小单位），见 @cex/shared/bigint.ts 精度红线

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  // shadow 库仅 prisma migrate dev 使用（对比迁移、生成 SQL），生产 migrate deploy 不需要
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  status       String   @default("ACTIVE") // ACTIVE | FROZEN | DISABLED
  region       String?
  invitedBy    String? // 注册时填写的邀请码 = 邀请人 uid（仅记录关系，不结算返佣）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  security  UserSecurity?
  kyc       Kyc?
  orders    Order[]
  deposits  Deposit[]
  withdraws Withdraw[]
  secEvents SecurityEvent[]
}

model UserSecurity {
  uid              String    @id
  totpSecretEnc    String?
  totpEnabled      Boolean   @default(false)
  whitelistEnabled Boolean   @default(false)
  forbiddenUntil   DateTime? // 24h 禁提截止时间（反劫持红线）
  tokenVersion     Int       @default(0) // 全端会话失效：改密/重置密码时 +1，旧 JWT 全部作废
  user             User      @relation(fields: [uid], references: [id])
}

model Kyc {
  id           String   @id @default(cuid())
  uid          String   @unique
  realName     String
  idHash       String   @unique // 证件号哈希，一人一号查重
  idNumberEnc  String // 证件号加密存储
  country      String
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectReason String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [uid], references: [id])
}

model DepositAddress {
  id      String @id @default(cuid())
  uid     String
  chain   String
  coin    String
  address String
  hdPath  String

  @@unique([uid, coin, chain])
  @@unique([chain, address])
}

model Deposit {
  id            String    @id @default(cuid())
  uid           String
  coin          String
  chain         String
  amount        BigInt
  txid          String
  logIndex      Int       @default(0)
  confirmations Int       @default(0)
  status        String    @default("DETECTED") // DETECTED | CONFIRMED | CREDITED | DROPPED | REVERSED
  creditedAt    DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [uid], references: [id])

  @@unique([txid, logIndex]) // 充值幂等红线
  @@index([uid, createdAt])
}

model Withdraw {
  id           String   @id @default(cuid())
  uid          String
  coin         String
  chain        String
  address      String
  amount       BigInt
  fee          BigInt   @default(0)
  status       String   @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED | BROADCASTING | BROADCASTED | COMPLETED | CANCELLED
  txid         String?
  rejectReason String?
  auditor1     String?
  auditor2     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [uid], references: [id])

  @@index([uid, createdAt])
  @@index([status])
}

model Asset {
  uid       String
  coin      String
  available BigInt   @default(0)
  frozen    BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@id([uid, coin])
}

// 不可变账务流水（流程图 5.1）：只增不改不删，差错走冲正（REVERSAL）。
// 对账恒等式：SUM(availDelta) == Asset.available；SUM(frozenDelta) == Asset.frozen。
model AssetFlow {
  id           String   @id @default(cuid())
  uid          String
  coin         String
  bizNo        String   @unique // 账务幂等根本：同单号重放返回原流水，不重复记账
  type         String // CREDIT | DEBIT | FREEZE | UNFREEZE | REVERSAL
  availDelta   BigInt // 本次对「可用余额」的净变化（带符号）
  frozenDelta  BigInt // 本次对「冻结余额」的净变化（带符号）
  availBefore  BigInt // 余额快照：操作前可用
  availAfter   BigInt // 余额快照：操作后可用
  frozenBefore BigInt // 余额快照：操作前冻结
  frozenAfter  BigInt // 余额快照：操作后冻结
  ref          String? // 关联业务单号：充值txid / 订单id / 提现单号 / 冲正的原bizNo
  createdAt    DateTime @default(now())

  @@index([uid, createdAt])
}

model Order {
  id            String   @id @default(cuid())
  clientOrderId String   @unique // 下单幂等
  uid           String
  pair          String
  side          String // BUY | SELL
  type          String // LIMIT | MARKET
  price         BigInt?
  amount        BigInt
  quoteAmount   BigInt?
  filled        BigInt   @default(0)
  status        String   @default("ACCEPTED") // ACCEPTED | PARTIAL_FILLED | FILLED | CANCELED | REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [uid], references: [id])

  @@index([uid, createdAt])
  @@index([pair, status])
}

model Trade {
  id           String   @id @default(cuid())
  pair         String
  seq          BigInt
  takerOrderId String
  makerOrderId String
  price        BigInt
  amount       BigInt
  takerFee     BigInt   @default(0)
  makerFee     BigInt   @default(0)
  createdAt    DateTime @default(now())

  @@unique([pair, seq]) // 清算幂等
}

model PairConfig {
  pair           String  @id
  baseCoin       String
  quoteCoin      String
  basePrecision  Int
  quotePrecision Int
  minAmount      BigInt
  minNotional    BigInt
  makerFeeRateBp Int // 手续费率，基点（bp）
  takerFeeRateBp Int
  tradingEnabled Boolean @default(false)
}

model ChainConfig {
  id               String  @id @default(cuid())
  chain            String
  coin             String
  minDeposit       BigInt
  minWithdraw      BigInt
  withdrawFee      BigInt
  confirmations    Int
  depositEnabled   Boolean @default(false)
  withdrawEnabled  Boolean @default(false)
  hotWalletAddress String?
  hotWalletLimit   BigInt  @default(0)

  @@unique([chain, coin])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String
  before    String?
  after     String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  uid       String
  type      String // LOGIN | NEW_DEVICE | PASSWORD_CHANGED | TOTP_CHANGED | WHITELIST_CHANGED
  ip        String?
  userAgent String? // 新设备判断 = IP + UA 历史未出现（流程图 1.2 情况3）
  createdAt DateTime @default(now())
  user      User     @relation(fields: [uid], references: [id])

  @@index([uid, type, createdAt])
}

// M1 决策：邮件先写 outbox（可查不发），M2-5 接真实 SMTP
model MailLog {
  id        String    @id @default(cuid())
  uid       String?
  to        String // 收件邮箱
  type      String // REGISTER_CODE | RESET_CODE | WELCOME | NEW_DEVICE | PASSWORD_CHANGED ...
  payload   String // JSON：模板变量（如验证码）
  status    String    @default("PENDING") // PENDING | SENT | FAILED
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([to, type, createdAt])
  @@index([status])
}

model WalletCursor {
  chain        String   @id
  scannedBlock BigInt   @default(0)
  updatedAt    DateTime @updatedAt
}
